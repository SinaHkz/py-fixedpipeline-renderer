mtllib room.mtl

# Floor
usemtl Floor
v -4.0 0.0 -4.0
v  4.0 0.0 -4.0
v  4.0 0.0  4.0
v -4.0 0.0  4.0
vt 0.0 0.0
vt 4.0 0.0
vt 4.0 4.0
vt 0.0 4.0
vn 0.0 1.0 0.0
f 1/1/1 2/2/1 3/3/1 4/4/1

# Front Wall
usemtl Front
v -4.0 0.0 -4.0
v  4.0 0.0 -4.0
v  4.0 3.0 -4.0
v -4.0 3.0 -4.0
vt 0.0 0.0
vt 2.0 0.0
vt 2.0 1.0
vt 0.0 1.0
vn 0.0 0.0 1.0
f 5/5/2 6/6/2 7/7/2 8/8/2

# Left Wall
usemtl Left
v -4.0 0.0 -4.0
v -4.0 0.0  4.0
v -4.0 3.0  4.0
v -4.0 3.0 -4.0
vt 2.0 0.0
vt 0.0 0.0
vt 0.0 1.0
vt 2.0 1.0
vn 1.0 0.0 0.0
f 9/9/3 10/10/3 11/11/3 12/12/3

# Right Wall
usemtl Right
v 4.0 0.0 -4.0
v 4.0 0.0  4.0
v 4.0 3.0  4.0
v 4.0 3.0 -4.0
vt 0.0 0.0
vt 2.0 0.0
vt 2.0 1.0
vt 0.0 1.0
vn -1.0 0.0 0.0
f 13/13/4 14/14/4 15/15/4 16/16/4
